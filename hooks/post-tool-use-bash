#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# advpl-specialist - PostToolUse hook (Bash)
#
# Puts the sources a Bash call converted with convert-encoding.sh --to-utf8 on
# the session's pending list (advpl_pending_add in post-tool-use), so
# hooks/stop converts them back to Windows-1252 at the end of the turn even
# when Claude ran --to-utf8 without reading the file first (post-tool-use-read
# lists it on Read) and then never edited it (post-tool-use lists it on Edit).
# Listing a file that was not converted is harmless: hooks/stop runs the
# converter in its normal mode, which leaves a Windows-1252 file as it is
# ("already-cp1252").
#
# Only tool_input.command and cwd of the stdin JSON are read. The command is
# data: it is never run nor eval'ed. An awk lexer reads it the way bash would,
# for a small subset of the shell:
#   - words: unquoted text, '...', "..." (escapes \$ \` \" \\ and
#     \<newline>), \c outside quotes; \<newline> joins two lines;
#   - simple commands separated by ";", "&&", "||" or a newline; "#" at the
#     start of a word opens a comment; redirections (> >> < >& <& &> &>> >|
#     <>, with an optional fd number) are skipped along with their target;
#   - a converter run is a simple command whose first word is the script (its
#     last path component is convert-encoding.sh) or is bash/sh followed by
#     the script. Its arguments are read as convert-encoding.sh reads them:
#     options up to "--" (--dry-run, --to-utf8, --translit, -r), the rest are
#     paths. Listed: the paths with a lint extension (.prw .prx .tlpp .th, any
#     case) of a run with --to-utf8 and without --translit, -h, --help or an
#     unknown option (those are usage errors: nothing is converted);
#   - a relative path is joined to the payload's cwd only when the converter
#     run is the only simple command of the line (a cd before or after it
#     would move it) and cwd is absolute.
# Nothing at all is listed when the line holds a pipe, "&" (background), "("
# or ")", a command substitution ($( or `), $'...', $"...", a ${...} other
# than ${NAME}, a heredoc (<< or <<<), an unterminated quote, or an argument of
# the converter run with an expansion ($NAME, ~, *, ?, [, {, }): which files
# the shell handed to the converter is then unknown. Expansions in the script
# word or before it are accepted (bash "${CLAUDE_PLUGIN_ROOT}/.../
# convert-encoding.sh", the form of the plugin's commands): they do not change
# the files that follow. With -r the files found under a directory are not
# listed (the hook does not walk directories). In all these cases the Read
# (post-tool-use-read) and the Edit (post-tool-use) of a file still put it on
# the list.
#
# Never blocks: always exit 0, never a byte on stdout or stderr, internal
# errors included. Cheap: a payload that does not hold both
# "convert-encoding.sh" and "--to-utf8" stops at a string test; the converter
# is never run. The helpers (payload reader with the jq fallback and CR
# removal, absolute path test, lint extension test, pending list) come from
# post-tool-use, which stops right after its definitions when sourced.

set -u

case "${BASH_SOURCE[0]}" in
  */*) HOOK_DIR=${BASH_SOURCE[0]%/*} ;;
  *) HOOK_DIR=. ;;
esac
# Not followed by shellcheck, for the reason given in post-tool-use-read.
# shellcheck source=/dev/null
. "$HOOK_DIR/post-tool-use" >/dev/null 2>&1 || exit 0

# converter_targets: reads a shell command line on stdin; prints one line per
# path handed to a convert-encoding.sh --to-utf8 run (rules above): "1 PATH"
# when that run is the only simple command of the line, "0 PATH" otherwise.
# Prints nothing when the line holds a construct listed above. A path holding
# a line break is dropped.
converter_targets() {
  awk '
    { S = S (NR > 1 ? "\n" : "") $0 }

    function bad() { BAD = 1 }

    function base(w,   i, c) {
      for (i = length(w); i > 0; i--) {
        c = substr(w, i, 1)
        if (c == "/" || c == "\\") break
      }
      return substr(w, i + 1)
    }

    # dollar(i): the expansion opened by the "$" at S[i], appended to the
    # word, which becomes tainted; returns the index after it. bad() for the
    # forms whose end this lexer cannot find.
    function dollar(i,   d, j) {
      d = substr(S, i + 1, 1)
      if (d ~ /[A-Za-z_]/) {
        for (j = i + 2; j <= N && substr(S, j, 1) ~ /[A-Za-z0-9_]/; j++) ;
      } else if (d != "" && index("0123456789@*#?$!-", d)) {
        j = i + 2
      } else if (d == "{") {
        j = index(substr(S, i + 2), "}")
        if (j < 2 || substr(S, i + 2, j - 1) !~ /^[A-Za-z_][A-Za-z0-9_]*$/) { bad(); return N + 1 }
        j = i + 2 + j
      } else {
        bad(); return N + 1
      }
      W = W substr(S, i, j - i); TAINT = 1; INWORD = 1
      return j
    }

    # word(w, t): one word of the current simple command (t: tainted)
    function word(w, t) {
      if (STATE == 0) {            # command name
        if (!t && (base(w) == "bash" || base(w) == "sh" || base(w) == "bash.exe" || base(w) == "sh.exe")) STATE = 1
        else if (base(w) == "convert-encoding.sh") STATE = 2
        else STATE = 3
      } else if (STATE == 1) {     # bash/sh: the script comes next
        STATE = (base(w) == "convert-encoding.sh") ? 2 : 3
      } else if (STATE == 2) {     # arguments of the converter
        if (t) { bad(); return }
        if (!OPTS_DONE && w == "--") OPTS_DONE = 1
        else if (!OPTS_DONE && w == "--to-utf8") TO_UTF8 = 1
        else if (!OPTS_DONE && w == "--translit") TRANSLIT = 1
        else if (!OPTS_DONE && (w == "--dry-run" || w == "-r")) { }
        else if (!OPTS_DONE && w ~ /^-./) USAGE = 1
        else P[++NP] = w
      }
    }

    function end_word() {
      if (!INWORD) return
      if (REDIR) REDIR = 0         # a redirection target: skipped
      else word(W, TAINT)
      W = ""; INWORD = 0; TAINT = 0; QUOTED = 0
    }

    function end_cmd(   k) {
      end_word()
      if (REDIR) bad()             # redirection without a target
      if (STATE == 2 && TO_UTF8 && !TRANSLIT && !USAGE)
        for (k = 1; k <= NP; k++) T[++NT] = P[k]
      if (STATE) NCMD++
      STATE = 0; TO_UTF8 = 0; TRANSLIT = 0; USAGE = 0; OPTS_DONE = 0; NP = 0
    }

    # redirect(len): a redirection operator of len characters at S[i]
    function redirect(len) {
      if (INWORD && !QUOTED && !TAINT && W ~ /^[0-9]+$/) { W = ""; INWORD = 0 }   # fd number
      else end_word()
      if (REDIR) bad()
      REDIR = 1
      return len
    }

    END {
      N = length(S); i = 1
      while (i <= N && !BAD) {
        c = substr(S, i, 1); d = substr(S, i + 1, 1)
        if (c == "\047") {
          j = index(substr(S, i + 1), "\047")
          if (!j) { bad(); break }
          W = W substr(S, i + 1, j - 1); INWORD = 1; QUOTED = 1; i += j + 1
        } else if (c == "\"") {
          INWORD = 1; QUOTED = 1
          for (i++; i <= N && !BAD; i++) {
            c = substr(S, i, 1); d = substr(S, i + 1, 1)
            if (c == "\"") break
            if (c == "`") bad()
            else if (c == "$") i = dollar(i) - 1
            else if (c == "\\" && d == "\n") i++
            else if (c == "\\" && d != "" && index("$`\"\\", d)) { W = W d; i++ }
            else W = W c
          }
          if (i > N) bad()         # unterminated
          i++
        } else if (c == "\\") {
          if (d == "") { bad(); break }
          if (d != "\n") { W = W d; INWORD = 1; QUOTED = 1 }
          i += 2
        } else if (c == " " || c == "\t") {
          end_word(); i++
        } else if (c == "\n" || c == ";") {
          end_cmd(); i++
        } else if (c == "&") {
          if (d == "&") { end_cmd(); i += 2 }
          else if (d == ">") i += redirect(substr(S, i + 2, 1) == ">" ? 3 : 2)
          else bad()               # background
        } else if (c == "|") {
          if (d == "|") { end_cmd(); i += 2 }
          else bad()               # pipe
        } else if (c == ">") {
          i += redirect(d == ">" || d == "&" || d == "|" ? 2 : 1)
        } else if (c == "<") {
          if (d == "<") bad()      # heredoc, here-string
          else i += redirect(d == "&" || d == ">" ? 2 : 1)
        } else if (c == "(" || c == ")" || c == "`") {
          bad()
        } else if (c == "$") {
          i = dollar(i)
        } else if (c == "#" && !INWORD) {
          j = index(substr(S, i), "\n")
          i = j ? i + j - 1 : N + 1
        } else {
          if (index("~*?[{}", c)) TAINT = 1
          W = W c; INWORD = 1; i++
        }
      }
      if (!BAD) end_cmd()
      if (BAD) exit 0
      for (k = 1; k <= NT; k++)
        if (index(T[k], "\n") == 0) print (NCMD == 1 ? 1 : 0) " " T[k]
    }'
}

advpl_bash_pending() {
  local input cmd cwd line p
  input=$(cat)
  case $input in *convert-encoding.sh*) ;; *) return 0 ;; esac
  case $input in *--to-utf8*) ;; *) return 0 ;; esac
  cmd=$(advpl_hook_string .tool_input.command command "$input")
  # jq.exe on Windows ends every output line with CRLF, the inner lines of a
  # multi-line command included (advpl_hook_string drops only the last CR)
  cmd=${cmd//$'\r\n'/$'\n'}
  case $cmd in *convert-encoding.sh*--to-utf8*) ;; *) return 0 ;; esac
  cwd=$(advpl_hook_string .cwd cwd "$input")
  while IFS= read -r line; do
    p=${line#? }
    if ! advpl_is_abs_path "$p"; then
      case $line in "1 "?*) ;; *) continue ;; esac
      advpl_is_abs_path "$cwd" || continue
      while :; do
        case $p in ./*) p=${p#./} ;; *) break ;; esac
      done
      p="${cwd%[\\/]}/$p"
    fi
    advpl_is_lint_file "$p" || continue
    advpl_pending_add "$input" "$p"
  done <<<"$(printf '%s\n' "$cmd" | converter_targets)"
}

(advpl_bash_pending) >/dev/null 2>&1
exit 0
