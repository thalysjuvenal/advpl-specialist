#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# advpl-specialist - PostToolUse hook (Write|Edit|MultiEdit)
#
# After Claude writes or edits a file (tool_input.file_path of the stdin JSON):
#   1. U+FFFD bytes (EF BF BD) in the file: the encoding step is skipped (a
#      non-blocking note says so), so the corruption is not transliterated
#      away; ADV014 reports it in step 4 when it is on an introduced line
#      (U+FFFD already in the snapshot is legacy).
#   2. Encoding: UTF-8 -> Windows-1252 through convert_encoding, i.e.
#      skills/advpl-code-generation/scripts/convert-encoding.sh --translit (the
#      converter decides which extensions it handles). A character without a
#      Windows-1252 representation becomes "?" instead of blocking the edit,
#      and the "translit: FILE (N)" report line becomes a non-blocking note.
#      When the file was converted, a copy of the snapshot with the same
#      extension goes through the same converter, so a legacy file still in
#      UTF-8 compares like for like.
#   3. Introduced lines: numbers of the lines of the file whose text occurs
#      nowhere in the (normalized) snapshot; both sides compared without CR and
#      without a leading UTF-8 BOM. No snapshot = new file: the whole file is
#      linted, file-scope rules included. No introduced line = nothing to lint.
#   4. advpl-lint.sh --lines-file, only for .prw .prx .tlpp .th (any case), with
#      ${CLAUDE_PROJECT_DIR:-$PWD}/.advpl-specialist-ignore when readable.
#   5. Errors: findings and a hint on stderr, exit 2 (Claude sees them and fixes
#      the lines). Warnings only (or a skipped/failed/transliterated
#      conversion): JSON additionalContext on stdout, exit 0. Nothing to
#      report: exit 0, no output.
#   6. The snapshot is always removed (EXIT trap).
# Lint engine missing or failing: message on stderr, exit 1 (non-blocking).
# post-tool-use-read sources this file for its helpers (payload reader,
# plugin_script, json_escape, finish); the steps above run only when the file
# is executed.

set -u
export LC_ALL=C

case "${BASH_SOURCE[0]}" in
  */*) HOOK_DIR=${BASH_SOURCE[0]%/*} ;;
  *) HOOK_DIR=. ;;
esac
# shellcheck source=pre-tool-use
. "$HOOK_DIR/pre-tool-use"

# plugin_script REL: prints the path of a plugin script, looked up under the
# plugin root first, then next to this hook.
plugin_script() {
  local root
  for root in "${CLAUDE_PLUGIN_ROOT:-}" "$HOOK_DIR/.."; do
    if [ -n "$root" ] && [ -f "$root/$1" ]; then
      printf '%s' "$root/$1"
      return 0
    fi
  done
  return 1
}

# Single call site of the UTF-8 -> Windows-1252 converter (file and snapshot).
# --translit: an emoji in a comment must not block the edit; the caller turns
# the "translit: FILE (N)" report line into a visible note.
convert_encoding() {
  local conv
  if ! conv=$(plugin_script skills/advpl-code-generation/scripts/convert-encoding.sh); then
    echo "convert-encoding.sh nao encontrado"
    return 1
  fi
  "${BASH:-bash}" "$conv" --translit -- "$1"
}

lint_engine() { plugin_script skills/advpl-code-review/scripts/advpl-lint.sh; }

# introduced_lines SNAPSHOT FILE: 1-based numbers of the FILE lines whose text
# is absent from SNAPSHOT; on both sides a trailing CR and, on line 1, a UTF-8
# BOM are ignored. Paths go through ENVIRON and stdin: awk -v and file operands
# would mangle "\" and "a=b" names.
introduced_lines() {
  SNAP="$1" awk '
    BEGIN {
      BOM = sprintf("%c%c%c", 239, 187, 191)
      while ((getline l < ENVIRON["SNAP"]) > 0) {
        if (++n == 1 && substr(l, 1, 3) == BOM) l = substr(l, 4)
        sub(/\r$/, "", l); seen[l] = 1
      }
    }
    {
      if (NR == 1 && substr($0, 1, 3) == BOM) $0 = substr($0, 4)
      sub(/\r$/, ""); if (!($0 in seen)) print NR
    }' <"$2"
}

# Text on stdin -> body of a JSON string (no quotes), lines joined with \n.
json_escape() {
  awk 'BEGIN {
      for (i = 1; i < 32; i++) ESC[sprintf("%c", i)] = sprintf("\\u%04x", i)
      ESC["\t"] = "\\t"; ESC["\r"] = "\\r"; ESC["\\"] = "\\\\"; ESC["\""] = "\\\""
    }
    {
      n = length($0); o = ""
      for (i = 1; i <= n; i++) { c = substr($0, i, 1); o = o ((c in ESC) ? ESC[c] : c) }
      printf "%s%s", (NR > 1 ? "\\n" : ""), o
    }'
}

# Exit 0, passing $notes (if any) to Claude as non-blocking context.
finish() {
  if [ -n "$notes" ]; then
    printf '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"%s"}}\n' \
      "$(printf '%s\n' "$notes" | json_escape)"
  fi
  exit 0
}

# Sourced by post-tool-use-read for the helpers above: stop here.
[ "${BASH_SOURCE[0]}" = "$0" ] || return 0

input=$(cat)
file=$(advpl_hook_file_path "$input")
[ -n "$file" ] || exit 0
snap=$(advpl_snapshot_file "$file")
baseline=$snap   # what the file is compared with (step 3)
trap 'rm -f "$snap" "$snap.lines" "$baseline"' EXIT
[ -f "$file" ] || exit 0

notes=""
converted=0
if grep -q "$(printf '\357\277\275')" "$file"; then
  # step 1: keep U+FFFD visible to ADV014
  notes="advpl-specialist: conversao para Windows-1252 nao executada em $file: o arquivo contem U+FFFD (bytes EF BF BD); restaure os caracteres originais"
elif conv=$(convert_encoding "$file" 2>&1); then
  converted=1
  case $conv in
    *"translit: "*)
      notes="advpl-specialist: caracteres sem representacao em Windows-1252 viraram '?' na conversao ($conv); revise esses trechos" ;;
  esac
else
  notes="advpl-specialist: falha na conversao para Windows-1252 de $file${conv:+: $conv}"
fi

advpl_is_lint_file "$file" || finish

lint_args=()
if [ -f "$snap" ]; then
  # normalize the snapshot exactly like the file: same converter, same
  # decision, and a copy named with the file's extension for its filter
  if [ "$converted" = 1 ] && cp "$snap" "$snap.${file##*.}" 2>/dev/null; then
    baseline="$snap.${file##*.}"
    convert_encoding "$baseline" >/dev/null 2>&1
  fi
  introduced_lines "$baseline" "$file" >"$snap.lines"
  [ -s "$snap.lines" ] || finish
  lint_args=(--lines-file "$snap.lines")
fi
ignore="${CLAUDE_PROJECT_DIR:-$PWD}/.advpl-specialist-ignore"
if [ -f "$ignore" ] && [ -r "$ignore" ]; then
  lint_args+=(--ignore-file "$ignore")
fi

if ! engine=$(lint_engine); then
  echo "advpl-specialist: advpl-lint.sh nao encontrado; lint ignorado para $file" >&2
  exit 1
fi
out=$("${BASH:-bash}" "$engine" ${lint_args[@]+"${lint_args[@]}"} -- "$file")
rc=$?

case $rc in
  0)
    if printf '%s\n' "$out" | grep -qv '^advpl-lint: '; then
      notes="advpl-specialist: avisos do lint nas linhas introduzidas (nao bloqueiam; corrija se aplicavel):
$out${notes:+
$notes}"
    fi
    finish
    ;;
  1)
    {
      echo "advpl-specialist: o lint encontrou erros nas linhas introduzidas:"
      printf '%s\n' "$out"
      [ -z "$notes" ] || printf '%s\n' "$notes"
      echo "advpl-specialist: corrija as linhas acima; para falso positivo use .advpl-specialist-ignore"
    } >&2
    exit 2
    ;;
  *)
    echo "advpl-specialist: advpl-lint.sh falhou (exit $rc) para $file" >&2
    exit 1
    ;;
esac
