#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# advpl-specialist - PostToolUse hook (Write|Edit|MultiEdit)
#
# After Claude writes or edits a file (tool_input.file_path of the stdin JSON):
#   1. Pending list: a source the converter handles (the strict
#      convert-encoding.sh --dry-run report is not "skipped") goes on the
#      session's pending list (advpl_pending_add); hooks/stop converts the
#      listed files back to Windows-1252 at the end of the turn. The file is
#      not converted here: Claude Code's Edit refuses a file that is not valid
#      UTF-8, so a source converted after each Edit could not take the next one.
#   2. Notes on that source (non-blocking):
#      - U+FFFD bytes (EF BF BD): the end-of-turn conversion skips the file
#        too, so the corruption is not transliterated away; ADV014 reports it
#        in step 4 when it is on an introduced line (U+FFFD already in the
#        snapshot is legacy).
#      - otherwise, characters without a Windows-1252 representation (the dry
#        run reports "failed: FILE (incompatible char)"): they become "?" at
#        the end of the turn, so Claude is asked to replace them now.
#   3. Introduced lines: numbers of the lines of the file whose text occurs
#      nowhere in the snapshot. Both are compared as Windows-1252: copies named
#      with the file's extension go through convert-encoding.sh --translit, so
#      a line whose only change is its encoding (a source converted with
#      --to-utf8, a legacy file still in UTF-8) is not introduced; the
#      conversion keeps every line break, so the numbers are those of the
#      file. A trailing CR and a leading UTF-8 BOM are ignored on both sides.
#      No snapshot = new file: the whole file is linted, file-scope rules
#      included. No introduced line = nothing to lint.
#   4. advpl-lint.sh --lines-file on the file itself, only for .prw .prx .tlpp
#      .th (any case), with ${CLAUDE_PROJECT_DIR:-$PWD}/.advpl-specialist-ignore
#      when readable.
#   5. Errors: findings and a hint on stderr, exit 2 (Claude sees them and fixes
#      the lines). Warnings only (or a note from step 2): JSON additionalContext
#      on stdout, exit 0. Nothing to report: exit 0, no output.
#   6. The snapshot and its copies are always removed (EXIT trap).
# Lint engine missing or failing: message on stderr, exit 1 (non-blocking).
# post-tool-use-read and stop source this file for its helpers (payload
# reader, plugin_script, convert_encoding, pending list, json_escape, finish);
# the steps above run only when the file is executed.

set -u
export LC_ALL=C

case "${BASH_SOURCE[0]}" in
  */*) HOOK_DIR=${BASH_SOURCE[0]%/*} ;;
  *) HOOK_DIR=. ;;
esac
# shellcheck source=pre-tool-use
. "$HOOK_DIR/pre-tool-use"

ADVPL_FFFD=$(printf '\357\277\275')   # U+FFFD in UTF-8

# plugin_script REL: prints the path of a plugin script, looked up under the
# plugin root first, then next to this hook.
plugin_script() {
  local root
  for root in "${CLAUDE_PLUGIN_ROOT:-}" "$HOOK_DIR/.."; do
    if [ -n "$root" ] && [ -f "$root/$1" ]; then
      printf '%s' "$root/$1"
      return 0
    fi
  done
  return 1
}

# convert_encoding ARG...: skills/advpl-code-generation/scripts/
# convert-encoding.sh ARG... (stdout: its report, one line per file; its exit
# status); 127 without output when the script is missing.
convert_encoding() {
  local conv
  conv=$(plugin_script skills/advpl-code-generation/scripts/convert-encoding.sh) || return 127
  "${BASH:-bash}" "$conv" "$@"
}

lint_engine() { plugin_script skills/advpl-code-review/scripts/advpl-lint.sh; }

# advpl_pending_list JSON: the session's pending list, the sources hooks/stop
# converts back to Windows-1252 at the end of the turn:
# ${CLAUDE_PLUGIN_DATA:-${TMPDIR:-/tmp}}/advpl-specialist-pending/<session_id>,
# every byte of the id outside [A-Za-z0-9_-] turned into "_" (the name stays a
# file of that directory), "nosession" when the payload has no session_id.
advpl_pending_list() {
  local id
  id=$(advpl_hook_string .session_id session_id "$1" | tr -c 'A-Za-z0-9_-' '_')
  printf '%s/advpl-specialist-pending/%s' "${CLAUDE_PLUGIN_DATA:-${TMPDIR:-/tmp}}" "${id:-nosession}"
}

# advpl_pending_add JSON FILE: puts FILE on the session's list unless it is
# already there, one path per line. Hooks of parallel tool calls may append at
# the same time: each appends one line with a single printf >> (hooks/stop
# drops duplicates anyway). A path with a line break cannot be listed.
advpl_pending_add() {
  local list
  case $2 in *$'\n'*) return 1 ;; esac
  list=$(advpl_pending_list "$1")
  if [ -f "$list" ] && grep -qxF -e "$2" -- "$list" 2>/dev/null; then return 0; fi
  (umask 077 && mkdir -p "${list%/*}" && printf '%s\n' "$2" >>"$list") 2>/dev/null
}

# introduced_lines SNAPSHOT FILE: 1-based numbers of the FILE lines whose text
# is absent from SNAPSHOT; on both sides a trailing CR and, on line 1, a UTF-8
# BOM are ignored. Paths go through ENVIRON and stdin: awk -v and file operands
# would mangle "\" and "a=b" names.
introduced_lines() {
  SNAP="$1" awk '
    BEGIN {
      BOM = sprintf("%c%c%c", 239, 187, 191)
      while ((getline l < ENVIRON["SNAP"]) > 0) {
        if (++n == 1 && substr(l, 1, 3) == BOM) l = substr(l, 4)
        sub(/\r$/, "", l); seen[l] = 1
      }
    }
    {
      if (NR == 1 && substr($0, 1, 3) == BOM) $0 = substr($0, 4)
      sub(/\r$/, ""); if (!($0 in seen)) print NR
    }' <"$2"
}

# Text on stdin -> body of a JSON string (no quotes), lines joined with \n.
json_escape() {
  awk 'BEGIN {
      for (i = 1; i < 32; i++) ESC[sprintf("%c", i)] = sprintf("\\u%04x", i)
      ESC["\t"] = "\\t"; ESC["\r"] = "\\r"; ESC["\\"] = "\\\\"; ESC["\""] = "\\\""
    }
    {
      n = length($0); o = ""
      for (i = 1; i <= n; i++) { c = substr($0, i, 1); o = o ((c in ESC) ? ESC[c] : c) }
      printf "%s%s", (NR > 1 ? "\\n" : ""), o
    }'
}

# Exit 0, passing $notes (if any) to Claude as non-blocking context.
finish() {
  if [ -n "$notes" ]; then
    printf '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"%s"}}\n' \
      "$(printf '%s\n' "$notes" | json_escape)"
  fi
  exit 0
}

# Sourced by post-tool-use-read or stop for the helpers above: stop here.
[ "${BASH_SOURCE[0]}" = "$0" ] || return 0

input=$(cat)
file=$(advpl_hook_file_path "$input")
[ -n "$file" ] || exit 0
snap=$(advpl_snapshot_file "$file")
ext=${file##*/}; ext=${ext##*.}
base="$snap.base.$ext"   # snapshot and file as Windows-1252 (step 3)
cur="$snap.cur.$ext"
trap 'rm -f "$snap" "$snap.lines" "$base" "$cur"' EXIT
[ -f "$file" ] || exit 0

notes=""
report=$(convert_encoding --dry-run -- "$file" 2>/dev/null)
case $report in
  "" | "skipped: "*) ;;   # not a source the converter handles
  *)
    advpl_pending_add "$input" "$file"
    if grep -q -e "$ADVPL_FFFD" -- "$file"; then
      notes="advpl-specialist: conversao para Windows-1252 nao executada em $file: o arquivo contem U+FFFD (bytes EF BF BD); restaure os caracteres originais (com U+FFFD, a reconversao do fim do turno tambem pula o arquivo)"
    elif [ "$report" = "failed: $file (incompatible char)" ]; then
      notes="advpl-specialist: $file tem caracteres sem representacao em Windows-1252; no fim do turno, quando o plugin reconverte o arquivo para Windows-1252, eles viram '?'. Troque-os agora por caracteres que existem no Windows-1252"
    fi
    ;;
esac

advpl_is_lint_file "$file" || finish

lint_args=()
if [ -f "$snap" ]; then
  if cp "$snap" "$base" 2>/dev/null && cp "$file" "$cur" 2>/dev/null; then
    convert_encoding --translit -- "$base" "$cur" >/dev/null 2>&1
    introduced_lines "$base" "$cur" >"$snap.lines"
  else
    introduced_lines "$snap" "$file" >"$snap.lines"
  fi
  [ -s "$snap.lines" ] || finish
  lint_args=(--lines-file "$snap.lines")
fi
ignore="${CLAUDE_PROJECT_DIR:-$PWD}/.advpl-specialist-ignore"
if [ -f "$ignore" ] && [ -r "$ignore" ]; then
  lint_args+=(--ignore-file "$ignore")
fi

if ! engine=$(lint_engine); then
  echo "advpl-specialist: advpl-lint.sh nao encontrado; lint ignorado para $file" >&2
  exit 1
fi
out=$("${BASH:-bash}" "$engine" ${lint_args[@]+"${lint_args[@]}"} -- "$file")
rc=$?

case $rc in
  0)
    if printf '%s\n' "$out" | grep -qv '^advpl-lint: '; then
      notes="advpl-specialist: avisos do lint nas linhas introduzidas (nao bloqueiam; corrija se aplicavel):
$out${notes:+
$notes}"
    fi
    finish
    ;;
  1)
    {
      echo "advpl-specialist: o lint encontrou erros nas linhas introduzidas:"
      printf '%s\n' "$out"
      [ -z "$notes" ] || printf '%s\n' "$notes"
      echo "advpl-specialist: corrija as linhas acima; para falso positivo use .advpl-specialist-ignore"
    } >&2
    exit 2
    ;;
  *)
    echo "advpl-specialist: advpl-lint.sh falhou (exit $rc) para $file" >&2
    exit 1
    ;;
esac
