root = true

[*.{md,mdx,mdown}]
charset = utf-8
trim_trailing_whitespace = true
end_of_line = lf
insert_final_newline = true

[*.{js,ts,tsx,json,css,scss}]
indent_style = space
indent_size = 2
charset = utf-8
trim_trailing_whitespace = true
end_of_line = lf
insert_final_newline = true

[*.{prw,tlpp,advpl}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = true
