# advpl-lint.rules - single source of rules for advpl-lint.sh and advpl-lint.ps1.
#
# One rule per line, 11 TAB-separated fields; lines starting with "#" are comments:
#   ID  SEVERITY  SCOPE  KIND  TARGET  CASE  EXTS  REGEX  REGEX2  MESSAGE  REF
# SEVERITY error|warn (error only for patterns with no legitimate use)
# SCOPE    line|file
# KIND     forbid|require|balance|undeclared
# TARGET   code (comments and literal contents blanked) | raw (original line)
# CASE     i (REGEX/REGEX2 written in lowercase, matched against the lowercased line) | c
# EXTS     comma list of prw,prx,tlpp,th or *
# REGEX2   forbid: exception searched in the matched text after dropping its
#          leading characters outside [A-Za-z0-9_#]; balance: counterpart regex
# REGEX2 and REF are "-" when empty. MESSAGE in pt-BR saying what to use instead.
# Regex subset: portable ERE, no \b, no [[:class:]], no {m,n}, no lookaround, no
# backreference; use [ \t] and [A-Za-z0-9_]. Keep this file ASCII only.
# Left word boundary: start REGEX with exactly (^|[^a-z0-9_]) in CASE=i rules or
# (^|[^A-Za-z0-9_]) in CASE=c rules. The engine strips it and requires that the
# character before the match is not [A-Za-z0-9_]; it applies to the whole rest
# of the REGEX (wrap alternatives in a group) and is not part of the matched text.
# Matches on one line never overlap, and "^" only matches the real line start.

ADV001	error	line	forbid	raw	i	*	^[ \t]*#[ \t]*include[ \t]*["'<][ \t]*protheus\.ch[ \t]*["'>]	-	include obsoleto; use #include "totvs.ch" em vez de protheus.ch	-
ADV002	error	line	forbid	raw	c	*	^[ \t]*#[ \t]*[Ii][Nn][Cc][Ll][Uu][Dd][Ee][ \t]*["'<][^"'>]*["'>]	^#[ \t]*include[ \t]*["'<][^"'<>A-Z]*["'>]$	include fora do padrao; use diretiva e nome em minusculas (#include "totvs.ch")	CA3001
ADV003	error	line	forbid	code	i	*	(^|[^a-z0-9_])((conout|outerr)[ \t]*\(|^[ \t]*\?\??)	-	use FWLogMsg() em vez de ConOut()/OutErr()/?	CA1004
ADV004	error	line	forbid	code	i	*	(^|[^a-z0-9_])staticcall[ \t]*\(	-	funcao restrita; use FWLoadModel()/FWLoadMenuDef() ou chamada direta em vez de StaticCall()	CA2022
ADV005	error	line	forbid	code	i	*	(^|[^a-z0-9_])ptinternal[ \t]*\(	-	funcao restrita sem excecao; remova PTInternal()	CA2023
ADV006	error	line	forbid	code	i	*	(^|[^a-z0-9_])__cuserid[ \t]*:=	-	__cUserID e variavel somente leitura; nao atribua, apenas leia (use RetCodUsr()/FWGetUserCode quando precisar)	CA2024
ADV007	error	line	forbid	code	i	*	(^|[^a-z0-9_])cempant[ \t]*:=	-	cEmpAnt e variavel somente leitura; troque de empresa com RpcSetEnv()/FWSM0Util em vez de atribuir	CA2025
ADV008	error	line	forbid	raw	i	*	(^|[^a-z0-9_])dbselectarea[ \t]*\([ \t]*["'](sx[0-9a-z]|sm0|six)[0-9]*["']	-	acesso direto a tabela de sistema (SX*/SM0/SIX); use FWSX3Util, GetMV/SuperGetMV, FWSM0Util ou outra API do framework	CA2000-CA2013
ADV009	warn	line	forbid	code	i	*	(^|[^a-z0-9_])iif[ \t]*\(	-	evite IIf() inline; use bloco If/Else/EndIf	CA4000
ADV010	error	line	forbid	code	i	*	(^|[^a-z0-9_])(dbcreate|mscreate)[ \t]*\(	-	API da era ISAM; use FWTemporaryTable em modo relacional	CA1000
ADV011	warn	line	forbid	code	i	*	(^|[^a-z0-9_])criatrab[ \t]*\(	-	API da era ISAM; use FWTemporaryTable em modo relacional (CriaTrab so para nome de arquivo)	CA1000
ADV012	error	line	forbid	raw	i	*	(^|[^a-z0-9_])with[ \t]*\([ \t]*nolock[ \t]*\)	-	WITH(NOLOCK) permite leitura suja e nao funciona em todos os bancos; remova a dica	-
ADV013	error	line	forbid	code	i	*	(^|[^a-z0-9_])using[ \t]+namespace[ \t]+tlpp\.[a-z0-9_.]*	tlpp\.probat	namespace tlpp.* e desnecessario; use os includes .th (tlpp-core.th, tlpp-rest.th, tlpp-object.th)	-
ADV014	error	line	forbid	raw	c	*	\357\277\275	-	caractere U+FFFD (substituicao): o arquivo foi salvo com encoding errado; restaure o texto e salve em Windows-1252	CA0000
ADV015	warn	line	forbid	code	i	*	(^|[^a-z0-9_])(cquery|csql|cqry)[ \t]*(\+=|:=|=)[^=].*\+[ \t]*[a-z_(]	-	possivel concatenacao em SQL (injecao); use BeginSQL/EndSQL com %exp:% ou FWPreparedStatement	CA2050
ADV016	error	line	forbid	code	i	*	(^|[^a-z0-9_])local[ \t]+([a-z0-9_]+([ \t]*:=[^,]*)?[ \t]*,[ \t]*)*(cempant|cfilant|ddatabase|__cuserid|cusername|nmodulo|cmodulo)([^a-z0-9_]|$)	-	Local redeclara variavel de ambiente do Protheus (cEmpAnt, cFilAnt, dDataBase...); remova a declaracao e apenas leia a variavel	-
